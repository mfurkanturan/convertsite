---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import Logo from '../components/logo.svelte';
import Footer from '../components/footer.svelte';
import Icon from '../components/icon.svelte';
import { brand } from '../lib/brand';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  updatedAt?: string;
}

const { title, description, updatedAt = '22 Ekim 2026' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://doctorconverter.com').toString();
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — {brand.name}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — ${brand.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — ${brand.name}`} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <!-- Top Minimal Navigation -->
    <header class="sticky top-0 z-30 flex h-[72px] items-center justify-between border-b border-border bg-surface/95 px-8 backdrop-blur-md max-sm:px-4">
      <Logo />
      <a href="/" class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-bg px-3.5 py-1.5 text-xs font-semibold text-text-soft transition-colors hover:border-accent hover:text-accent">
        <Icon name="back" size={14} />
        <span>Ana Sayfaya Dön</span>
      </a>
    </header>

    <!-- Main Content Container -->
    <main class="mx-auto max-w-[840px] px-6 py-12 max-sm:py-8">
      <header class="mb-10 border-b border-border pb-6">
        <h1 class="font-display text-[clamp(26px,3vw,36px)] font-bold tracking-tight text-text">{title}</h1>
        <p class="mt-2 text-sm text-text-muted">Son güncelleme: {updatedAt}</p>
      </header>

      <article class="prose prose-slate max-w-none text-[15px] leading-relaxed text-text-soft [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-text [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1.5">
        <slot />
      </article>
    </main>

    <!-- Footer -->
    <Footer client:visible />
  </body>
</html>
