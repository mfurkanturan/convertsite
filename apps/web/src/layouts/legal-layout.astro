---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import Logo from '../components/logo.svelte';
import Icon from '../components/icon.svelte';
import LanguageSwitch from '../components/language-switch.svelte';
import SeoHead from '../components/seo-head.astro';
import SiteFooter from '../components/site-footer.astro';
import { brand } from '../lib/brand';
import { ui } from '../i18n/ui';
import { htmlLang, localePath, staticPairs, type Locale } from '../i18n/locales';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  updatedAt?: string;
  locale?: Locale;
}

const { title, description, locale = 'tr', updatedAt = locale === 'tr' ? '22 Ekim 2026' : 'October 22, 2026' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const alternates = staticPairs.find((pair) => pair[locale] === path) ?? { [locale]: path };
const switchHref = alternates[locale === 'tr' ? 'en' : 'tr'];
const text = ui[locale];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <SeoHead {locale} title={`${title} — ${brand.name}`} {description} {alternates} />
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <header class="sticky top-0 z-30 flex h-[72px] items-center justify-between gap-3 border-b border-border bg-surface/95 px-8 backdrop-blur-md max-sm:px-4">
      <Logo href={localePath(locale, '/')} {locale} />
      <div class="flex items-center gap-2">
        {switchHref && <LanguageSwitch href={switchHref} {locale} />}
        <a href={localePath(locale, '/')} class="inline-flex h-10 items-center gap-1.5 rounded-lg border border-border bg-bg px-3.5 text-xs font-semibold text-text-soft transition-colors hover:border-accent hover:text-accent">
          <Icon name="back" size={14} />
          <span>{text.legal.back}</span>
        </a>
      </div>
    </header>

    <main id="main-content" class="mx-auto max-w-[840px] px-6 py-12 max-sm:py-8">
      <header class="mb-10 border-b border-border pb-6">
        <h1 class="font-display text-[clamp(26px,3vw,36px)] font-bold tracking-tight text-text">{title}</h1>
        <p class="mt-2 text-sm text-text-muted">{text.legal.updated} {updatedAt}</p>
      </header>

      <article class="prose prose-slate max-w-none text-[15px] leading-relaxed text-text-soft [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-text [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-text [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1.5">
        <slot />
      </article>
    </main>

    <SiteFooter {locale} />
  </body>
</html>
