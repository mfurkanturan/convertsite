---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import AppShell from '../components/app-shell.svelte';
import SeoHead from '../components/seo-head.astro';
import DrOttoAssistant from '../components/dr-otto-assistant.svelte';
import SiteFooter from '../components/site-footer.astro';
import { htmlLang, type Alternates, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates: Alternates;
  keywords?: string[];
  jsonLd?: unknown;
  /** Tool opened on load; omitted on the home page. */
  toolId?: string;
  heading?: { title: string; lead: string };
}
const { locale, title, description, alternates, keywords, jsonLd, toolId, heading } = Astro.props;
const text = ui[locale].controls;
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <SeoHead {locale} {title} {description} {alternates} {keywords} {jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{text.skipToContent}</a>
    <AppShell client:load {locale} initialToolId={toolId} {heading} switchAlternates={alternates}>
      <slot />
      <slot name="home" slot="home" />
    </AppShell>
    <SiteFooter {locale} alternates={alternates} />
    <DrOttoAssistant client:load {locale} />
  </body>
</html>
