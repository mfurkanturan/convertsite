---
import type { ToolId } from '@convertsite/contracts';
import AppLayout from './app-layout.astro';
import ToolSeoSection from '../components/tool-seo-section.astro';
import { toolSeoMap } from '../lib/tool-seo';
import { toolSeoMapEn } from '../lib/tool-seo-en';
import { toolGraph } from '../lib/seo/structured-data';
import { localePath, type Locale } from '../i18n/locales';

interface Props { locale: Locale; toolId: ToolId }
const { locale, toolId } = Astro.props;
const data = (locale === 'tr' ? toolSeoMap : toolSeoMapEn)[toolId];
const path = localePath(locale, `/${toolId}`);
const alternates = { en: `/${toolId}`, tr: `/tr/${toolId}` };
---
<AppLayout {locale} title={data.metaTitle} description={data.metaDescription} {alternates} keywords={data.keywords}
  jsonLd={toolGraph(locale, data, path)} toolId={toolId} heading={{ title: data.h1, lead: data.lead }}>
  <ToolSeoSection {data} {locale} />
</AppLayout>
