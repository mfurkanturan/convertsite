---
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';
import { groupLabels, groupOrder, scenarios, scenarioBase, scenarioPath } from '../lib/seo/scenarios';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = ui[locale].seo;
// One highlighted guide per audience keeps the home page short but links every segment.
const picks = groupOrder.flatMap((group) => scenarios[locale].filter((item) => item.group === group).slice(0, 2));
---
<section id="guides" class="mt-14 border-t border-border pt-12 max-[600px]:mt-10 max-[600px]:pt-9" aria-labelledby="guides-title">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="guides-title" class="font-display text-[clamp(22px,2.2vw,28px)] font-semibold tracking-[-0.02em] text-text">{text.hubTitle}<span class="text-accent">.</span></h2>
      <p class="mt-1.5 max-w-2xl text-[15px] text-text-soft">{text.hubLead}</p>
    </div>
    <a href={localePath(locale, scenarioBase[locale])} class="text-sm font-semibold text-accent hover:underline">{ui[locale].footer.allGuides} →</a>
  </div>
  <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {picks.map((item) => (
      <li>
        <a href={scenarioPath(locale, item.slug)} class="group flex h-full flex-col rounded-card border border-border bg-surface p-5 transition-colors hover:border-accent/50">
          <span class="text-xs font-semibold text-accent">{groupLabels[locale][item.group]}</span>
          <span class="mt-1.5 text-[15px] font-semibold text-text group-hover:text-accent">{item.title}</span>
          <span class="mt-1.5 text-sm text-text-soft line-clamp-2">{item.lead}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
