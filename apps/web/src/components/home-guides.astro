---
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';
import { groupLabels, groupOrder, scenarios, scenarioBase, scenarioPath } from '../lib/seo/scenarios';
import HomeGuidesShowcase from './home-guides-showcase.svelte';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = ui[locale].seo;

// All picks with their localized group label and route
const items = groupOrder.flatMap((group) =>
  scenarios[locale]
    .filter((item) => item.group === group)
    .slice(0, 2)
    .map((item) => ({
      slug: item.slug,
      group: item.group,
      groupLabel: groupLabels[locale][item.group],
      title: item.title,
      lead: item.lead,
      steps: item.steps,
      href: scenarioPath(locale, item.slug),
    }))
);
const featured = (items.find((item) => item.group === 'student') ?? items[0])!;
const sideGuides = ['legal', 'finance']
  .map((group) => items.find((item) => item.group === group && item.slug !== featured?.slug))
  .filter((item) => item !== undefined);
const quickGuides = ['visa', 'career', 'office']
  .map((group) => items.find((item) => item.group === group))
  .filter((item) => item !== undefined);
---
<HomeGuidesShowcase
  client:idle
  locale={locale}
  hubTitle={text.hubTitle}
  hubLead={text.hubLead}
  allGuidesHref={localePath(locale, scenarioBase[locale])}
  allGuidesLabel={ui[locale].footer.allGuides}
  featured={featured}
  sideGuides={sideGuides}
  quickGuides={quickGuides}
/>
