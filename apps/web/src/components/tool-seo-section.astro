---
import type { ToolSeoData } from '../lib/tool-seo';
import { tools } from '../lib/tools';

interface Props {
  data: ToolSeoData;
}

const { data } = Astro.props;
const related = tools.filter((t) => data.relatedTools.includes(t.id));
---

<div class="mt-12 space-y-12 border-t border-border/70 pt-10 text-text">
  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-muted">
    <a href="/" class="hover:text-primary transition-colors">Ana Sayfa</a>
    <span>/</span>
    <span class="text-text font-medium">{data.title}</span>
  </nav>

  <!-- How-To Guide Section -->
  <section class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
        <span>⚡ 3 Kolay Adım</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">
        {data.title} Nasıl Yapılır?
      </h2>
      <p class="mt-2 text-sm text-muted">
        Karmaşık programlara ihtiyaç duymadan, tarayıcınız üzerinden saniyeler içinde belgenizi dönüştürün.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {data.steps.map((step, index) => (
        <div class="relative rounded-xl border border-border/60 bg-bg/50 p-5 flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-primary text-white font-bold flex items-center justify-center text-sm shadow-xs mb-3">
              {index + 1}
            </div>
            <h3 class="text-base font-semibold text-text">{step.title}</h3>
            <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Features Grid -->
  <section class="space-y-6">
    <div class="text-center max-w-xl mx-auto">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">
        Neden DoctorConverter?
      </h2>
      <p class="mt-1 text-sm text-muted">
        Güvenli, hızlı ve gizliliğinizi koruyan modern dönüştürme altyapısı.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {data.features.map((feature) => (
        <div class="rounded-2xl border border-border bg-surface p-6 shadow-xs hover:border-primary/40 transition-colors">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-lg mb-4">
            ✓
          </div>
          <h3 class="text-base font-semibold text-text">{feature.title}</h3>
          <p class="mt-2 text-xs sm:text-sm text-muted leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xs">
    <div class="max-w-2xl mb-6">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">
        Sıkça Sorulan Sorular
      </h2>
      <p class="mt-1 text-sm text-muted">
        {data.title} hakkında en çok merak edilen sorular ve cevapları.
      </p>
    </div>

    <div class="space-y-4">
      {data.faqs.map((faq) => (
        <details class="group rounded-xl border border-border/60 bg-bg/40 p-4 open:bg-bg transition-colors">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm sm:text-base text-text">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 text-muted transition-transform group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-muted leading-relaxed border-t border-border/40 pt-3">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- Related Tools -->
  {related.length > 0 && (
    <section class="space-y-4 pt-4">
      <h2 class="text-lg font-bold text-text">
        İlgili Diğer Popüler Araçlar
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {related.map((tool) => (
          <a
            href={`/${tool.id}`}
            class="group flex flex-col justify-between rounded-xl border border-border bg-surface p-4 shadow-2xs hover:border-primary hover:shadow-xs transition-all"
          >
            <div>
              <div class="font-semibold text-sm text-text group-hover:text-primary transition-colors">
                {tool.name}
              </div>
              <p class="mt-1 text-xs text-muted line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 flex items-center gap-1 text-xs font-medium text-primary">
              <span>Hemen Dene</span>
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</div>
