---
import type { ToolSeoData } from '../lib/tool-seo';
import { getTools } from '../lib/tools';
import { ui } from '../i18n/ui';
import { localePath, localeRoutes, type Locale } from '../i18n/locales';
import { scenariosForTool, scenarioPath } from '../lib/seo/scenarios';

interface Props { data: ToolSeoData; locale: Locale }
const { data, locale } = Astro.props;
const text = ui[locale].seo;
const tools = getTools(locale);
const related = tools.filter((tool) => data.relatedTools.includes(tool.id));
const allGuides = scenariosForTool(locale, data.id);
const guides = [...allGuides].sort((a, b) => Number(b.tool === data.id) - Number(a.tool === data.id)).slice(0, 4);
const guidesHub = localePath(locale, localeRoutes[locale].guides);
---

<div class="editorial-content mt-12 space-y-10 border-t border-border pt-8 text-text">
  <section aria-labelledby="tool-steps-title">
    <h2 id="tool-steps-title" class="text-xl font-semibold">{text.howTo(data.title)}</h2>
    <ol class="mt-5 grid gap-5 md:grid-cols-3">
      {data.steps.map((step, index) => (
        <li class="flex gap-3">
          <span class="pt-0.5 text-sm font-medium text-text-muted" aria-hidden="true">{index + 1}.</span>
          <div>
            <h3 class="text-base font-semibold">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-text-soft">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-t border-border pt-6" aria-labelledby="tool-result-title">
    <h2 id="tool-result-title" class="text-xl font-semibold">{text.resultTitle}</h2>
    <p class="mt-3 max-w-3xl text-base leading-relaxed text-text-soft">{data.resultCheck}</p>
  </section>

  {guides.length > 0 && (
    <section class="border-t border-border pt-6">
      <h2 class="text-xl font-semibold">{text.guidesTitle(data.title)}</h2>
      <ul class="mt-3 grid gap-x-8 sm:grid-cols-2">
        {guides.map((guide) => (
          <li class="border-b border-border py-3">
            <a href={scenarioPath(locale, guide.slug)} class="inline-flex min-h-11 items-center text-sm font-medium text-accent underline-offset-4 hover:underline">{guide.title}</a>
          </li>
        ))}
      </ul>
      {allGuides.length > guides.length && <a href={guidesHub} class="mt-3 inline-flex min-h-11 items-center text-sm text-accent underline-offset-4 hover:underline">{ui[locale].footer.allGuides} →</a>}
    </section>
  )}

  <section class="border-t border-border pt-6">
    <h2 class="text-xl font-semibold">{text.faq}</h2>
    <div class="mt-4">
      {data.faqs.map((faq) => (
        <details class="editorial-faq group border-b border-border">
          <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 py-3 text-base font-medium">
            <span>{faq.question}</span><span class="text-text-muted group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="max-w-3xl pb-5 text-sm leading-relaxed text-text-soft">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section>
      <h2 class="text-lg font-semibold">{text.related}</h2>
      <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
        {related.map((tool) => <li><a href={localePath(locale, `/${tool.id}`)} class="inline-flex min-h-11 items-center text-sm font-medium text-accent underline-offset-4 hover:underline">{tool.name} →</a></li>)}
      </ul>
    </section>
  )}
</div>
