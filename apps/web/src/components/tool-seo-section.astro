---
import type { ToolSeoData } from '../lib/tool-seo';
import { getTools } from '../lib/tools';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';
import { scenariosForTool, scenarioPath, groupLabels } from '../lib/seo/scenarios';

interface Props { data: ToolSeoData; locale: Locale }
const { data, locale } = Astro.props;
const text = ui[locale].seo;
const tools = getTools(locale);
const related = tools.filter((t) => data.relatedTools.includes(t.id));
const toolName = tools.find((t) => t.id === data.id)?.name ?? data.title;
const guides = scenariosForTool(locale, data.id);
---

<div class="mt-12 space-y-12 border-t border-border/70 pt-10 text-text">
  <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-text-muted">
    <a href={localePath(locale, '/')} class="hover:text-accent transition-colors">{text.home}</a>
    <span>/</span>
    <span class="text-text font-medium">{data.title}</span>
  </nav>

  <section class="rounded-panel border border-border bg-surface p-6 sm:p-8">
    <div class="max-w-2xl">
      <span class="inline-flex items-center rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">{text.stepsBadge}</span>
      <h2 class="mt-3 text-xl sm:text-2xl font-bold tracking-tight text-text">{text.howTo(data.title)}</h2>
      <p class="mt-2 text-sm text-text-soft">{text.howLead}</p>
    </div>
    <ol class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {data.steps.map((step, index) => (
        <li class="rounded-card border border-border/60 bg-bg/50 p-5">
          <span class="mb-3 flex h-8 w-8 items-center justify-center rounded-lg bg-accent text-sm font-bold text-white">{index + 1}</span>
          <h3 class="text-base font-semibold text-text">{step.title.replace(/^\d+\.\s*/, '')}</h3>
          <p class="mt-2 text-sm text-text-soft leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  {guides.length > 0 && (
    <section class="rounded-panel border border-border bg-surface p-6 sm:p-8">
      <div class="max-w-2xl mb-6">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">{text.guidesTitle(toolName)}</h2>
        <p class="mt-2 text-sm text-text-soft">{text.guidesLead}</p>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {guides.map((guide) => (
          <li>
            <a href={scenarioPath(locale, guide.slug)} class="group flex h-full flex-col rounded-card border border-border/70 bg-bg/40 p-5 transition-colors hover:border-accent/50">
              <span class="text-xs font-semibold text-accent">{groupLabels[locale][guide.group]}</span>
              <span class="mt-1.5 text-base font-semibold text-text group-hover:text-accent">{guide.title}</span>
              <span class="mt-1.5 text-sm text-text-soft line-clamp-2">{guide.lead}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {data.useCases && data.useCases.length > 0 && (
    <section class="rounded-panel border border-border bg-surface p-6 sm:p-8">
      <div class="max-w-2xl mb-6">
        <span class="inline-flex items-center rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">{text.useCasesBadge}</span>
        <h2 class="mt-3 text-xl sm:text-2xl font-bold tracking-tight text-text">{text.idealFor(data.title)}</h2>
        <p class="mt-2 text-sm text-text-soft">{text.useCasesLead}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {data.useCases.map((uc) => (
          <div class="flex flex-col justify-between rounded-card border border-border/70 bg-bg/40 p-5">
            <div>
              <div class="mb-3 flex items-center justify-between gap-2">
                <span class="rounded-md bg-accent-soft px-2.5 py-0.5 text-xs font-bold text-accent">{uc.tag}</span>
                <span class="text-xs font-medium text-text-muted">{uc.target}</span>
              </div>
              <h3 class="text-base font-semibold text-text">{uc.title}</h3>
              <p class="mt-2 text-sm text-text-soft leading-relaxed">{uc.description}</p>
            </div>
            <p class="mt-4 rounded-lg border border-border/50 bg-surface p-2.5 text-xs text-text"><strong>{text.benefit}</strong> {uc.benefit}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="space-y-6">
    <div class="text-center max-w-xl mx-auto">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">{text.why}</h2>
      <p class="mt-1 text-sm text-text-soft">{text.whyLead}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {data.features.map((feature) => (
        <div class="rounded-panel border border-border bg-surface p-6">
          <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-card bg-accent-soft text-lg text-accent" aria-hidden="true">✓</span>
          <h3 class="text-base font-semibold text-text">{feature.title}</h3>
          <p class="mt-2 text-sm text-text-soft leading-relaxed">{feature.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-panel border border-border bg-surface p-6 sm:p-8">
    <div class="max-w-2xl mb-6">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">{text.faq}</h2>
      <p class="mt-1 text-sm text-text-soft">{text.faqLead(data.title)}</p>
    </div>
    <div class="space-y-4">
      {data.faqs.map((faq) => (
        <details class="group rounded-card border border-border/60 bg-bg/40 p-4 open:bg-bg">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm sm:text-base text-text">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 text-text-muted transition-transform group-open:rotate-180" aria-hidden="true">▼</span>
          </summary>
          <p class="mt-3 border-t border-border/40 pt-3 text-sm text-text-soft leading-relaxed">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section class="space-y-4 pt-4">
      <h2 class="text-lg font-bold text-text">{text.related}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {related.map((tool) => (
          <a href={localePath(locale, `/${tool.id}`)} class="group flex flex-col justify-between rounded-card border border-border bg-surface p-4 transition-all hover:border-accent">
            <div>
              <div class="text-sm font-semibold text-text group-hover:text-accent transition-colors">{tool.name}</div>
              <p class="mt-1 text-xs text-text-muted line-clamp-2">{tool.description}</p>
            </div>
            <span class="mt-3 text-xs font-medium text-accent">{text.tryNow} →</span>
          </a>
        ))}
      </div>
    </section>
  )}
</div>
