---
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';

interface Props {
  placement: string;
  locale: Locale;
}

const { placement, locale } = Astro.props;
const text = ui[locale].controls.ad;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slotId = placement === 'home-after-tools'
  ? import.meta.env.PUBLIC_ADSENSE_SLOT_HOME_AFTER_TOOLS
  : undefined;
const configured = /^ca-pub-\d+$/.test(adsenseClient ?? '') && /^\d+$/.test(slotId ?? '');
---
{configured ? (
  <aside
    class="my-8 w-full overflow-hidden"
    aria-label={text.label}
    data-ad-placement={placement}
  >
    <ins
      class="adsbygoogle block min-h-[112px] w-full sm:min-h-[128px]"
      style="display:block"
      data-ad-client={adsenseClient}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </aside>
  <script is:inline>
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  </script>
) : import.meta.env.DEV ? (
  <aside
    class="my-6 flex min-h-16 w-full flex-col items-center justify-center gap-1 border-y border-border/70 px-4 py-3 text-center"
    aria-label={text.previewLabel}
    data-ad-placement={placement}
  >
    <span class="text-[11px] font-semibold uppercase tracking-wide text-text-muted">
      {text.previewTitle}
    </span>
    <p class="text-xs leading-relaxed text-text-muted">
      {text.previewText}
    </p>
  </aside>
) : null}
