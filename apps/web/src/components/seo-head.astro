---
import { brand } from '../lib/brand';
import { absoluteUrl, htmlLang, ogLocale, type Alternates, type Locale } from '../i18n/locales';
// Preloading the heading and body fonts keeps the H1 from re-wrapping (layout shift) when they arrive.
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import soraLatinExt from '@fontsource-variable/sora/files/sora-latin-ext-wght-normal.woff2?url';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Equivalent URLs per language; the current page must be included. */
  alternates: Alternates;
  keywords?: string[];
  jsonLd?: unknown;
}
const { locale, title, description, alternates, keywords, jsonLd } = Astro.props;
const canonical = absoluteUrl(alternates[locale] ?? Astro.url.pathname);
const links = (Object.entries(alternates) as [Locale, string][]).filter(([, path]) => path);
// English is the global fallback when a page has no language-specific match.
const xDefault = alternates.en ?? alternates.es ?? alternates.tr;
// Localized share cards are not available yet for Spanish, Hindi or French.
const image = absoluteUrl(`/og/og-${locale === 'tr' ? 'tr' : 'en'}.jpg`);
const imageAlt = locale === 'tr' ? `${brand.name} – PDF ve belge araçları, tek yerde` : locale === 'es' ? `${brand.name} – herramientas para PDF y documentos` : locale === 'hi' ? `${brand.name} – PDF और दस्तावेज़ टूल` : locale === 'fr' ? `${brand.name} – outils PDF et documents` : `${brand.name} – every PDF and document tool in one place`;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const validAdsenseClient = /^ca-pub-\d+$/.test(adsenseClient ?? '');
---
<script is:inline>
(function () {
  var preference = 'system';
  try { var saved = localStorage.getItem('dc-theme'); if (saved === 'light' || saved === 'dark' || saved === 'system') preference = saved; } catch (e) {}
  var media = window.matchMedia('(prefers-color-scheme: dark)');
  function apply() { document.documentElement.dataset.theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference; document.documentElement.dataset.themePreference = preference; }
  apply();
  media.addEventListener('change', function () { if (preference === 'system') apply(); });
  window.addEventListener('dc-theme-change', function (event) { preference = event.detail; apply(); try { localStorage.setItem('dc-theme', preference); } catch (e) {} });
  window.addEventListener('storage', function (event) { if (event.key === 'dc-theme') { preference = event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : 'system'; apply(); window.dispatchEvent(new Event('dc-theme-sync')); } });
})();
</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{keywords?.length ? <meta name="keywords" content={keywords.join(', ')} /> : null}
<meta name="theme-color" content="#2563eb" />
{validAdsenseClient ? <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script> : null}
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />
{links.length > 1 && links.map(([lang, path]) => <link rel="alternate" hreflang={htmlLang[lang]} href={absoluteUrl(path)} />)}
{links.length > 1 && xDefault ? <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault)} /> : null}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preload" as="font" type="font/woff2" href={soraLatin} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
{locale === 'tr' && <link rel="preload" as="font" type="font/woff2" href={soraLatinExt} crossorigin />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={brand.name} />
<meta property="og:locale" content={ogLocale[locale]} />
{links.filter(([lang]) => lang !== locale).map(([lang]) => <meta property="og:locale:alternate" content={ogLocale[lang]} />)}
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{jsonLd ? <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} /> : null}

<!--
  Language routing: 1) the visitor's saved choice, 2) browser language, 3) Cloudflare country.
  Crawlers are never redirected, so each language version is indexed on its own URL.
-->
<script is:inline>
  (function () {
    try {
      var current = document.documentElement.lang === 'es' ? 'es' : document.documentElement.lang === 'tr' ? 'tr' : document.documentElement.lang === 'hi' ? 'hi' : document.documentElement.lang === 'fr' ? 'fr' : 'en';
      var alternates = {};
      document.querySelectorAll('link[rel="alternate"][hreflang]').forEach(function (link) {
        var lang = link.getAttribute('hreflang').toLowerCase().split('-')[0];
        if (lang === 'en' || lang === 'es' || lang === 'tr' || lang === 'hi' || lang === 'fr') alternates[lang] = link.href;
      });
      if (navigator.webdriver || /bot|crawl|spider|slurp|google|bing|yandex|baidu|duckduck|lighthouse|headless|preview/i.test(navigator.userAgent)) return;
      // An explicit language URL is the visitor's choice; only negotiate on English URLs.
      if (/^\/(?:es|tr|hi|fr)(?:\/|$)/.test(location.pathname)) return;
      var go = function (want) { if (want && want !== current && alternates[want]) location.replace(new URL(alternates[want]).pathname + location.hash); };
      var saved = null;
      try { saved = localStorage.getItem('dc-locale'); } catch (e) {}
      if (saved === 'tr' || saved === 'en' || saved === 'es' || saved === 'hi' || saved === 'fr') return go(saved);
      // Moving around inside the site never switches language on its own.
      if (document.referrer && new URL(document.referrer).host === location.host) return;
      var lang = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
      if (lang.indexOf('tr') === 0) return go('tr');
      if (lang.indexOf('es') === 0) return go('es');
      if (lang.indexOf('hi') === 0) return go('hi');
      if (lang.indexOf('fr') === 0) return go('fr');
      if (lang.indexOf('en') === 0) return go('en');
      fetch('/cdn-cgi/trace').then(function (r) { return r.text(); }).then(function (text) {
        var country = (text.match(/loc=([A-Z]{2})/) || [])[1];
        var spanishCountries = ['ES','MX','AR','BO','CL','CO','CR','CU','DO','EC','SV','GQ','GT','HN','NI','PA','PY','PE','PR','UY','VE'];
        var frenchCountries = ['FR','BE','CH','LU','CA'];
        go(country === 'TR' || country === 'CY' ? 'tr' : country === 'IN' ? 'hi' : frenchCountries.indexOf(country) >= 0 ? 'fr' : spanishCountries.indexOf(country) >= 0 ? 'es' : 'en');
      }).catch(function () {});
    } catch (e) {}
  })();
</script>
