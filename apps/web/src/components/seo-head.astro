---
import { brand } from '../lib/brand';
import { absoluteUrl, htmlLang, ogLocale, type Alternates, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Equivalent URLs per language; the current page must be included. */
  alternates: Alternates;
  keywords?: string[];
  jsonLd?: unknown;
}
const { locale, title, description, alternates, keywords, jsonLd } = Astro.props;
const canonical = absoluteUrl(alternates[locale] ?? Astro.url.pathname);
const links = (Object.entries(alternates) as [Locale, string][]).filter(([, path]) => path);
// English is the fallback for searchers whose language is neither Turkish nor English.
const xDefault = alternates.en ?? alternates.tr;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{keywords?.length ? <meta name="keywords" content={keywords.join(', ')} /> : null}
<meta name="theme-color" content="#2563eb" />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />
{links.map(([lang, path]) => <link rel="alternate" hreflang={htmlLang[lang]} href={absoluteUrl(path)} />)}
{links.length > 1 && xDefault ? <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault)} /> : null}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={brand.name} />
<meta property="og:locale" content={ogLocale[locale]} />
{links.filter(([lang]) => lang !== locale).map(([lang]) => <meta property="og:locale:alternate" content={ogLocale[lang]} />)}
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{jsonLd ? <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} /> : null}

<!--
  Language routing: 1) the visitor's saved choice, 2) browser language, 3) Cloudflare country.
  Crawlers are never redirected, so each language version is indexed on its own URL.
-->
<script is:inline>
  (function () {
    try {
      var current = document.documentElement.lang === 'en' ? 'en' : 'tr';
      var other = current === 'en' ? 'tr' : 'en';
      var alt = document.querySelector('link[rel="alternate"][hreflang="' + other + '"]');
      if (!alt || navigator.webdriver || /bot|crawl|spider|slurp|google|bing|yandex|baidu|duckduck|lighthouse|headless|preview/i.test(navigator.userAgent)) return;
      // Same-origin path keeps previews and staging on their own host.
      var go = function (want) { if (want && want !== current) location.replace(new URL(alt.href).pathname + location.hash); };
      var saved = null;
      try { saved = localStorage.getItem('dc-locale'); } catch (e) {}
      if (saved === 'tr' || saved === 'en') return go(saved);
      // Moving around inside the site never switches language on its own.
      if (document.referrer && new URL(document.referrer).host === location.host) return;
      var lang = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
      if (lang.indexOf('tr') === 0) return go('tr');
      if (lang.indexOf('en') === 0) return go('en');
      fetch('/cdn-cgi/trace').then(function (r) { return r.text(); }).then(function (text) {
        var country = (text.match(/loc=([A-Z]{2})/) || [])[1];
        go(country === 'TR' || country === 'CY' ? 'tr' : 'en');
      }).catch(function () {});
    } catch (e) {}
  })();
</script>
