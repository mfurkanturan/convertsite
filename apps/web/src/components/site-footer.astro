---
import AnalyticsConsent from './analytics-consent.svelte';
import Logo from './logo.svelte';
import LanguageSwitch from './language-switch.svelte';
import { brand } from '../lib/brand';
import { getTools, suggestedToolIds } from '../lib/tools';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';

interface Props { locale: Locale; alternateHref?: string }
const { locale } = Astro.props;
const text = ui[locale];
const tools = getTools(locale).filter((tool) => suggestedToolIds.includes(tool.id));
const hub = localePath(locale, locale === 'tr' ? '/kullanim/' : '/use-cases/');
const alternateHref = Astro.props.alternateHref ?? (locale === 'tr'
  ? Astro.url.pathname.replace(/^\/tr\/?/, '/')
  : `/tr${Astro.url.pathname}`);
const securityLegal = locale === 'tr'
  ? [['/guvenlik', text.links.security], ['/gizlilik', text.links.privacy], ['/kullanim-sartlari', text.links.terms]]
  : [['/security', text.links.security], ['/privacy', text.links.privacy], ['/terms', text.links.terms]];
const contactLinks = locale === 'tr'
  ? [['/hakkimizda', text.links.about], ['/iletisim', text.links.contact]]
  : [['/about', text.links.about], ['/contact', text.links.contact]];
---
<footer class="site-footer mt-14 border-t border-white/15 bg-brand-navy pt-8 pb-6">
  <div class="page-container">
    <div class="pb-5">
        <Logo href={localePath(locale, '/')} locale={locale} inverse />
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-text-soft">{text.footer.about}</p>
    </div>
    <div class="grid grid-cols-2 gap-x-6 gap-y-6 py-5 lg:grid-cols-4">
      <nav aria-label={text.footer.popular}>
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-text">{text.footer.popular}</h3>
        <ul class="mt-2 space-y-0 text-sm">
          {tools.map((tool) => <li><a href={localePath(locale, `/${tool.id}`)} class="inline-flex min-h-11 items-center text-text-soft transition-colors hover:text-accent">{tool.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={text.footer.guides}>
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-text">{text.footer.guides}</h3>
        <ul class="mt-2 space-y-0 text-sm">
          <li><a href={`${localePath(locale, '/')}#faq`} class="inline-flex min-h-11 items-center text-text-soft transition-colors hover:text-accent">{text.links.faq}</a></li>
          <li><a href={hub} class="inline-flex min-h-11 items-center font-semibold text-accent hover:underline">{text.footer.allGuides} →</a></li>
        </ul>
      </nav>
      <nav aria-label={text.footer.info}>
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-text">{text.footer.info}</h3>
        <ul class="mt-2 space-y-0 text-sm">
          {securityLegal.map(([href, label]) => <li><a href={localePath(locale, href)} class="inline-flex min-h-11 items-center text-text-soft transition-colors hover:text-accent">{label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={text.footer.contact}>
        <h3 class="text-[13px] font-semibold uppercase tracking-wide text-text">{text.footer.contact}</h3>
        <ul class="mt-2 space-y-0 text-sm">
          {contactLinks.map(([href, label]) => <li><a href={localePath(locale, href)} class="inline-flex min-h-11 items-center text-text-soft transition-colors hover:text-accent">{label}</a></li>)}
          <li><a href="mailto:doctorconverter@doctorconverter.com" class="inline-flex min-h-11 items-center text-text-soft transition-colors hover:text-accent [overflow-wrap:anywhere]">doctorconverter@doctorconverter.com</a></li>
        </ul>
      </nav>
    </div>
    <div class="flex flex-col items-start justify-between gap-4 border-t border-border pt-6 text-[13px] text-text-muted sm:flex-row sm:items-center">
      <p>© {brand.year} {brand.name} ({brand.domain}). {text.footer.rights}</p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <LanguageSwitch href={alternateHref} {locale} client:load />
        <AnalyticsConsent client:load {locale} />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer :global(nav a),
  .site-footer :global(.page-container > div > p),
  .site-footer :global(a[hreflang]),
  .site-footer :global(button[aria-controls="analytics-preferences"]) { color: var(--color-footer-text); }
  .site-footer :global(nav h3) { color: white; }
  .site-footer :global(nav a:hover),
  .site-footer :global(a[hreflang]:hover),
  .site-footer :global(button[aria-controls="analytics-preferences"]:hover) { color: var(--color-footer-accent); }
  .site-footer :global(nav a.font-semibold) { color: var(--color-footer-accent); }
  .site-footer :global(.border-t),
  .site-footer :global(a[hreflang]) { border-color: rgb(255 255 255 / 15%); }
  .site-footer :global(a:focus-visible),
  .site-footer :global(button:focus-visible) { outline-color: var(--color-footer-accent); }
</style>
