---
import AnalyticsConsent from './analytics-consent.svelte';
import Logo from './logo.svelte';
import { brand } from '../lib/brand';
import { getTools } from '../lib/tools';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';
import { scenarios, scenarioPath } from '../lib/seo/scenarios';

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = ui[locale];
const tools = getTools(locale);
const guides = scenarios[locale].slice(0, 8);
const legal = locale === 'tr'
  ? [['/hakkimizda', text.links.about], ['/guvenlik', text.links.security], ['/gizlilik', text.links.privacy], ['/kullanim-sartlari', text.links.terms], ['/iletisim', text.links.contact]]
  : [['/en/about', text.links.about], ['/en/security', text.links.security], ['/en/privacy', text.links.privacy], ['/en/terms', text.links.terms], ['/en/contact', text.links.contact]];
const hub = localePath(locale, locale === 'tr' ? '/kullanim/' : '/use-cases/');
---
<footer class="mt-20 border-t border-border bg-surface/80 pt-16 pb-12">
  <div class="mx-auto max-w-[1200px] px-10 max-[1180px]:px-7 max-[540px]:px-4">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="md:col-span-12 lg:col-span-3">
        <Logo href={localePath(locale, '/')} locale={locale} />
        <p class="mt-4 text-sm leading-relaxed text-text-soft">{text.footer.about}</p>
        <p class="mt-4 text-xs font-medium text-text-muted">{text.footer.retention}</p>
      </div>
      <nav class="md:col-span-4 lg:col-span-3" aria-label={text.footer.popular}>
        <h3 class="text-xs font-bold uppercase tracking-wider text-text">{text.footer.popular}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {tools.map((tool) => <li><a href={localePath(locale, `/${tool.id}`)} class="text-text-soft transition-colors hover:text-accent">{tool.name}</a></li>)}
        </ul>
      </nav>
      <nav class="md:col-span-5 lg:col-span-4" aria-label={text.footer.guides}>
        <h3 class="text-xs font-bold uppercase tracking-wider text-text">{text.footer.guides}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {guides.map((guide) => <li><a href={scenarioPath(locale, guide.slug)} class="text-text-soft transition-colors hover:text-accent">{guide.title}</a></li>)}
          <li><a href={hub} class="font-semibold text-accent hover:underline">{text.footer.allGuides} →</a></li>
        </ul>
      </nav>
      <div class="md:col-span-3 lg:col-span-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-text">{text.footer.info}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {legal.map(([href, label]) => <li><a href={href} class="text-text-soft transition-colors hover:text-accent">{label}</a></li>)}
          <li><a href="mailto:destek@doctorconverter.com" class="text-text-soft transition-colors hover:text-accent">destek@doctorconverter.com</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-xs text-text-muted sm:flex-row">
      <p>© {brand.year} {brand.name} ({brand.domain}). {text.footer.rights}</p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <a href={locale === 'tr' ? '/en/' : '/'} hreflang={locale === 'tr' ? 'en' : 'tr'} onclick={`try{localStorage.setItem('dc-locale','${locale === 'tr' ? 'en' : 'tr'}')}catch(e){}`} class="transition-colors hover:text-text">{text.switchTo}</a>
        {legal.map(([href, label]) => <a href={href} class="transition-colors hover:text-text">{label}</a>)}
        <AnalyticsConsent client:load {locale} />
      </div>
    </div>
  </div>
</footer>
