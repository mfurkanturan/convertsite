---
import { getTools } from '../lib/tools';
import { toolSeoMap } from '../lib/tool-seo';
import { toolSeoMapEn } from '../lib/tool-seo-en';
import { toolSeoMapEs } from '../lib/tool-seo-es';
import { toolSeoMapHi } from '../lib/tool-seo-hi';
import { toolSeoMapFr } from '../lib/tool-seo-fr';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';
import { figureSize, relatedScenarios, scenarioBase, scenarioPath, type Scenario } from '../lib/seo/scenarios';

interface Props { scenario: Scenario; locale: Locale }
const { scenario, locale } = Astro.props;
const text = ui[locale].seo;
const controls = ui[locale].controls;
const tools = getTools(locale).filter((tool) => scenario.tools.includes(tool.id));
const related = relatedScenarios(locale, scenario);
const outputCheck = ({ tr: toolSeoMap, en: toolSeoMapEn, es: toolSeoMapEs, hi: toolSeoMapHi, fr: toolSeoMapFr } as const)[locale][scenario.tool].resultCheck;
---

<article class="editorial-content mt-12 space-y-10 border-t border-border/70 pt-10 text-text">
  <nav aria-label={controls.breadcrumb} class="flex flex-wrap items-center gap-2 text-sm text-text-muted">
    <a href={localePath(locale, '/')} class="hover:text-accent">{text.home}</a><span>/</span>
    <a href={localePath(locale, scenarioBase[locale])} class="hover:text-accent">{text.hubTitle}</a><span>/</span>
    <span class="font-medium text-text">{scenario.title}</span>
  </nav>

  <section class="border-t border-border pt-6">
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">{text.stepsBadge}</h2>
    <ol class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-3">
      {scenario.steps.map((step, index) => (
        <li class="flex flex-col border-l border-border pl-4">
          <span class="mb-3 flex h-8 w-8 items-center justify-center text-sm font-medium text-text-muted">{index + 1}</span>
          <h3 class="text-base font-semibold text-text">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-soft">{step.text}</p>
        </li>
      ))}
    </ol>
    <a href="#workspace-title" class="mt-6 inline-flex min-h-11 items-center rounded-control bg-accent px-5 text-sm font-semibold text-white hover:bg-accent-strong">{text.startNow} ↑</a>
  </section>

  <section class="border-t border-border pt-6">
    <h2 class="text-xl font-semibold">{text.resultTitle}</h2>
    <p class="mt-3 max-w-3xl text-base leading-relaxed text-text-soft">{outputCheck}</p>
  </section>

  {scenario.sections.map((section, index) => (
    <>
      <section class="max-w-3xl">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">{section.heading}</h2>
        {section.body.map((paragraph) => <p class="mt-3 text-[15px] leading-relaxed text-text-soft">{paragraph}</p>)}
      </section>
      {index === 0 && scenario.figures && scenario.figures.length > 0 && (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {scenario.figures.map((figure) => {
            const [width, height] = figureSize[figure.src] ?? [1176, 900];
            return (
              <figure class="overflow-hidden rounded-panel border border-border bg-surface">
                <img src={`/guides/${figure.src}.jpg`} alt={figure.alt} width={width} height={height} loading="lazy" decoding="async" class="h-auto w-full" />
                <figcaption class="border-t border-border px-4 py-3 text-sm text-text-soft">{figure.caption}</figcaption>
              </figure>
            );
          })}
        </div>
      )}
      {index === 1 && scenario.comparison && (
        <section class="overflow-x-auto border-t border-border pt-6">
          <h2 class="text-xl font-bold tracking-tight text-text">{scenario.comparison.title}</h2>
          <table class="mt-4 w-full min-w-[560px] border-collapse text-left text-sm">
            <thead><tr>{scenario.comparison.head.map((cell) => <th scope="col" class="border-b border-border-strong px-3 py-2.5 font-semibold text-text">{cell}</th>)}</tr></thead>
            <tbody>
              {scenario.comparison.rows.map((row) => (
                <tr class="border-b border-border last:border-0">{row.map((cell, i) => i === 0 ? <th scope="row" class="px-3 py-2.5 font-medium text-text">{cell}</th> : <td class="px-3 py-2.5 text-text-soft">{cell}</td>)}</tr>
              ))}
            </tbody>
          </table>
          {scenario.comparison.note && <p class="mt-3 text-sm text-text-muted">{scenario.comparison.note}</p>}
        </section>
      )}
    </>
  ))}

  {scenario.tips.length > 0 && (
    <section class="max-w-3xl">
      <h2 class="text-xl font-bold tracking-tight text-text">{text.tips}</h2>
      <ul class="mt-4 space-y-3">
        {scenario.tips.map((tip) => <li class="flex gap-3 text-[15px] leading-relaxed text-text-soft"><span class="mt-1 text-success" aria-hidden="true">✓</span><span>{tip}</span></li>)}
      </ul>
    </section>
  )}

  <section>
    <h2 class="text-lg font-bold text-text">{text.toolsUsed}</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {tools.map((tool) => (
        <a href={localePath(locale, `/${tool.id}`)} class="group border-b border-border py-4 transition-colors hover:text-accent">
          <span class="block text-sm font-semibold text-text group-hover:text-accent">{tool.name}</span>
          <span class="mt-1 block text-sm text-text-muted">{tool.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-border pt-6">
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text">{text.faq}</h2>
    <div class="mt-5 space-y-4">
      {scenario.faqs.map((faq) => (
        <details class="group editorial-faq border-b border-border py-3">
          <summary class="flex min-h-11 cursor-pointer items-center justify-between font-medium text-sm sm:text-base text-text"><span>{faq.q}</span><span class="ml-4 text-text-muted transition-transform group-open:rotate-180" aria-hidden="true">▼</span></summary>
          <p class="mt-3 border-t border-border/40 pt-3 text-sm leading-relaxed text-text-soft">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section>
      <h2 class="text-lg font-bold text-text">{text.relatedGuides}</h2>
      <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {related.map((item) => (
          <li><a href={scenarioPath(locale, item.slug)} class="group block h-full border-b border-border py-4 transition-colors hover:text-accent">

            <span class="mt-1 block text-sm font-semibold text-text group-hover:text-accent">{item.title}</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}
</article>
