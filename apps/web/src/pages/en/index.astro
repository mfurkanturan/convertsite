---
import AppLayout from '../../layouts/app-layout.astro';
import HomeGuides from '../../components/home-guides.astro';
import { brand } from '../../lib/brand';
import { homeGraph } from '../../lib/seo/structured-data';
---
<AppLayout locale="en" title="Free PDF Converter – Merge, Compress, PDF to Word | DoctorConverter"
  description="Free online PDF tools: merge PDF, compress PDF, convert PDF to Word and Excel, JPG to PDF and OCR. No sign-up, works in your browser, files deleted automatically."
  alternates={{ tr: '/', en: '/en/' }} keywords={['pdf converter', 'merge pdf', 'compress pdf', 'pdf to word', 'pdf to excel', 'jpg to pdf', 'ocr', brand.name]}
  jsonLd={homeGraph('en')}>
  <HomeGuides slot="home" locale="en" />
</AppLayout>
