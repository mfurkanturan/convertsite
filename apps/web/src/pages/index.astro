---
import AppLayout from '../layouts/app-layout.astro';
import HomeGuides from '../components/home-guides.astro';
import AdSlot from '../components/ad-slot.astro';
import { brand } from '../lib/brand';
import { homeGraph } from '../lib/seo/structured-data';
---
<AppLayout locale="en" title="Free PDF Converter – Merge, Compress, PDF to Word | DoctorConverter"
  description="Free online PDF tools: merge, compress, convert PDF to Word or Excel, create PDFs from images, and run OCR. No account required; files are temporarily stored and expire according to the active service policy."
  alternates={{ en: '/', tr: '/tr/' }} keywords={['pdf converter', 'merge pdf', 'compress pdf', 'pdf to word', 'pdf to excel', 'jpg to pdf', 'ocr', brand.name]}
  jsonLd={homeGraph('en')}>
  <AdSlot slot="home" placement="home-after-tools" locale="en" />
  <HomeGuides slot="home" locale="en" />
</AppLayout>
