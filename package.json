{
  "name": "convertsite",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @convertsite/web dev",
    "build": "pnpm --filter @convertsite/server build && pnpm --filter @convertsite/web build",
    "check": "node scripts/check-boundaries.mjs && pnpm --filter @convertsite/server check && pnpm --filter @convertsite/web check",
    "dev:api": "pnpm --filter @convertsite/server dev",
    "dev:worker": "pnpm --filter @convertsite/server worker",
    "db:migrate": "pnpm --filter @convertsite/server migrate",
    "test": "node scripts/test-backend.mjs",
    "test:e2e": "playwright test",
    "setup:local": "node scripts/setup-local.mjs",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down",
    "preview": "pnpm --filter @convertsite/web preview",
    "stats": "node scripts/stats.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
